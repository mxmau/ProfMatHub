# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_API: Used for Netlify deployment
GEMINI_API="your_gemini_api_key_here"

# GROQ_API_KEY: Optional fallback when Gemini is overloaded (429 errors).
# Get a free key at https://console.groq.com/keys
# Uses Llama 3.3 70B model as a fallback provider.
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional fallback when both Gemini and Groq fail or are overloaded.
# Get a key at https://openrouter.ai/keys
# Uses a free model (e.g., Llama 3.3 70B Free or Gemini 2.5 Flash Free).
OPENROUTER_API_KEY="your_openrouter_api_key_here"

OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# NVIDIA_API_KEY: Optional premium fallback (Pro tier) when Gemini is overloaded.
# Get a key at https://build.nvidia.com/
# Example: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY="your_nvidia_api_key_here"

# NVIDIA_MODEL: The pro model to use as a fallback on NVIDIA NIM.
# Defaults to 'z-ai/glm-5.1'.
# Other options: 'meta/llama-3.3-70b-instruct', 'nvidia/llama-3.1-nemotron-70b-instruct', 'meta/llama-3.1-405b-instruct'
NVIDIA_MODEL="z-ai/glm-5.1"

